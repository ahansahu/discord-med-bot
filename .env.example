DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000
CHANNEL_ID=000000000000000000
# Optional: enables /todo commands and a pinned, button-driven todo list.
# Leave unset to disable the todo feature.
TODO_CHANNEL_ID=
# Optional: enables /bouzt currency + pari-mutuel betting commands in this
# channel. Leave unset to disable the Bouzt Gold feature. Requires the
# "Server Members Intent" to be enabled in the Discord Developer Portal.
BOUZT_CHANNEL_ID=
TARGET_USER_ID=000000000000000000
TIMEZONE=Europe/London
# Local SQLite path (used when DATABASE_URL is unset).
DB_PATH=med_bot.db

# On Railway, attach a Postgres database in the dashboard and Railway
# will inject DATABASE_URL automatically. When set, the bot uses Postgres
# and DB_PATH is ignored.
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Optional: paste a UptimeRobot heartbeat URL here to get email alerts
# if the bot stops running. See README → "Mitigations" for setup steps.
UPTIMEROBOT_HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MIN=30
